# Copy this file to ".env" and edit. Everything here is OPTIONAL —
# the app runs fine with none of it set.

JWT_SECRET=change-me-to-a-long-random-string
DATABASE_URL=sqlite:///./tripmind.db

# ---- OPTIONAL: turn on the LLM to reword replies (Groq works) ----
# The planner always works without this. If the call fails, the app quietly
# uses its built-in text, so your demo can never break because of it.
# OPENAI_API_KEY=gsk_your_groq_key_here
# LLM_BASE_URL=https://api.groq.com/openai/v1
# LLM_MODEL=llama-3.1-8b-instant
